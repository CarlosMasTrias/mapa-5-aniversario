# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a git.

# ── Supabase ──────────────────────────────────────────────
# Settings → API → Project URL y Project API Keys
VUE_APP_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VUE_APP_SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Credenciales del usuario seed (para scripts de desarrollo)
SEED_EMAIL=tu@email.com
SEED_PASSWORD=tu_password

# ── Cloudflare R2 – credenciales server-side ──────────────
# Solo disponibles en Node.js (dev server, scripts). NUNCA llegan al bundle.
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
R2_ACCOUNT_ID=TU_ACCOUNT_ID
R2_ACCESS_KEY_ID=TU_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY
R2_BUCKET_NAME=TU_BUCKET_NAME
R2_PUBLIC_URL=https://TU_CUSTOM_DOMAIN_O_R2_DEV_URL

# ── Cloudflare R2 – valores públicos (van al bundle de Vue) ──
VUE_APP_R2_PUBLIC_URL=https://TU_CUSTOM_DOMAIN_O_R2_DEV_URL
VUE_APP_R2_WORKER_URL=https://TU_WORKER.workers.dev
VUE_APP_R2_UPLOAD_SECRET=TU_UPLOAD_SECRET
